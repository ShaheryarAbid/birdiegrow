---
/**
 * Setup steps timeline — Figma "Progress/Setup/Steps" 466:32805. Same build as the homepage Setup block:
 * 960px alternating tile/text rows on a centre line, with a golf ball that travels as you scroll
 * (data-setup-progress, src/scripts/setup-progress.ts) and completed rows flipping their marker dark.
 * Props: heading, sub/note (lines under the heading), steps string[], icons (file names in /assets/integrations/, cycled), id.
 */
import { gd } from '../../lib/gd';
import '../../styles/home.css';
import '../../styles/sections.css';
import '../../styles/setup-timeline.css';
export interface Props { heading: string; sub?: string; steps: string[]; icons?: string[]; note?: string; id?: string; }
const { heading, sub, steps, icons = ['step-plug', 'step-pin', 'step-key', 'step-grid'], note, id } = Astro.props;
const A = '/assets/home/';
---
<section class="hm-sec hm-white hm-stack sx-setup" id={id}>
  <div class="hm-intro"><h2 class="hm-h2" set:html={gd(heading)} />{sub && <p class="hm-sub">{sub}</p>}{note && <p class="hm-sub">{note}</p>}</div>
  <div class="hm-setup" data-setup-progress>
    <div class="hm-setup__line" aria-hidden="true"></div>
    <div class="hm-setup__trail" aria-hidden="true"></div>
    <img class="hm-setup__ball" src={`${A}setup-ball.webp`} alt="" width="40" height="40" />
    {steps.map((s, i) => (
      <div class={`hm-setup__row${i % 2 === 0 ? ' tl' : ' tr'}${i === 0 ? ' feat' : ''}`}>
        <div class="hm-setup__side a">{i % 2 === 0 ? <div class="hm-setup__tile"><img class="ic" src={`/assets/integrations/${icons[i % icons.length]}.svg`} alt="" /></div> : <div class="hm-setup__txt"><h3>{s}</h3></div>}</div>
        <button type="button" class="hm-setup__mark" aria-label={`Step ${i + 1}: ${s}`}><span>{String(i + 1).padStart(2, '0')}</span><svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="m4 10 4 4 8-8" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
        <div class="hm-setup__side b">{i % 2 === 0 ? <div class="hm-setup__txt"><h3>{s}</h3></div> : <div class="hm-setup__tile"><img class="ic" src={`/assets/integrations/${icons[i % icons.length]}.svg`} alt="" /></div>}</div>
      </div>
    ))}
  </div>
</section>
<script>
  import { initSetupProgress } from '../../scripts/setup-progress';
  initSetupProgress();
</script>
