---
/**
 * Heading + 2x2 link cards — Figma "Explore the platform" 371:22069 (internal links with up-right arrow).
 * Props: heading, sub, items [label, href, sub?][] (a trailing "→" in the label is stripped).
 */
import { gd } from "../../lib/gd";
import "../../styles/sections.css";
export interface Props {
  heading: string;
  sub?: string;
  items: [string, string, string?][];
  id?: string;
}
const { heading, sub, items, id } = Astro.props;
const clean = (s: string) => s.replace(/\s*→\s*$/, "");
const endsPunct = /[.?!]$/.test(heading.trim());
---

<section class="hm-sec hm-white" id={id}>
  <div class="sx-lk">
    <div class="sx-lk__h">
      <h2 class="hm-h2" set:html={gd(heading)} />{
        sub && <p class="hm-sub">{sub}</p>
      }
    </div>
    <div class="sx-lk__grid">
      {
        items.map(([label, href, sub]) => (
          <a href={href}>
            <>
              <span>
                {clean(label)}
                {sub && <small>{sub}</small>}
              </span>
              <img
                src="/assets/icons/arrow-up-right.svg"
                alt=""
                width="24"
                height="24"
              />
            </>
          </a>
        ))
      }
    </div>
  </div>
</section>
