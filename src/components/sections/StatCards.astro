---
/**
 * Expanding stat cards — Figma "Product preview" 327:23942 ("How the two actually compare"). One card open at a time (first by default);
 * all text stays in the DOM. Stacks vertically on mobile. Props: heading, items [title, text][].
 */
import '../../styles/sections.css';
export interface Props { heading: string; items: [string, string][]; id?: string; note?: string; }
const { heading, items, id = 'acc', note } = Astro.props;
const icons = ['icon-bill', 'icon-door', 'icon-trophy'];
---
<section class="hm-sec hm-white hm-stack">
  <div class="hm-intro"><h2 class="hm-h2">{heading}<i>.</i></h2></div>
  <div class="sx-acc" data-acc>
    {items.map(([t, d], i) => (
      <article class={`sx-acc__card${i === 0 ? ' is-open' : ''}`}>
        <div class="sx-acc__art"></div>
        <button class="sx-tile" type="button" aria-expanded={i === 0 ? 'true' : 'false'} aria-controls={`${id}-${i}`} aria-label={t}>
          <img class="glyph" src={`/assets/sections/${icons[i % icons.length]}.svg`} alt="" />
        </button>
        <div class="sx-acc__body" id={`${id}-${i}`}><h3>{t}</h3><p>{d}</p></div>
      </article>
    ))}
  </div>
  {note && <p class="hm-sub">{note}</p>}
</section>
<script>
  document.querySelectorAll<HTMLElement>('[data-acc]').forEach((root) => {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.sx-acc__card'));
    const open = (card: HTMLElement) => cards.forEach((item) => {
      const active = item === card;
      item.classList.toggle('is-open', active);
      item.querySelector('.sx-tile')?.setAttribute('aria-expanded', String(active));
    });
    cards.forEach((card) => {
      const button = card.querySelector<HTMLButtonElement>('.sx-tile');
      card.addEventListener('click', () => open(card));
      card.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse') open(card);
      });
      button?.addEventListener('focus', () => open(card));
    });
  });
</script>
