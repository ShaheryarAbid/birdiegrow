---
/**
 * Verdict — Figma "Features / Option 8" 315:18556: competitor card (white) + Birdie card (dark) + "Verdict" box.
 * Props: heading, slug + name (competitor logo), paragraphs: the final paragraph (when 3+) becomes the Verdict box; the rest are
 * sorted into the Birdie card (paragraphs starting with "Birdie") or the competitor card, order preserved within each.
 */
import '../../styles/sections.css';
import Logo from './Logo.astro';
import { SHADER_DARK } from '../../data/shader';
export interface Props { heading: string; slug: string; name: string; paragraphs: string[]; }
const { heading, slug, name, paragraphs } = Astro.props;
const verdict = paragraphs.length >= 3 ? paragraphs[paragraphs.length - 1] : null;
const body = verdict ? paragraphs.slice(0, -1) : paragraphs;
const birdie = body.filter((p) => /^Birdie\b/.test(p));
const other = body.filter((p) => !/^Birdie\b/.test(p));
---
<section class="hm-sec hm-white hm-stack">
  <div class="hm-intro"><h2 class="hm-h2">{heading}<i>.</i></h2></div>
  <div class="sx-verdict">
    <div class="sx-vcards">
      {other.length > 0 && (
        <div class="sx-vcard">
          <div class="hd"><Logo slug={slug} alt={name} maxW={110} maxH={32} /></div>
          <div class="tx">{other.map((p) => <p>{p}</p>)}</div>
        </div>
      )}
      {birdie.length > 0 && (
        <div class="sx-vcard sx-vcard--dark">
          <div class="sx-vcard__art"><img src="/assets/sections/feature-artwork.webp" alt="" loading="lazy" /><div class="hm-shader hm-shader--overlay" data-shader-params={SHADER_DARK}><div class="px"></div></div><div class="hm-noise"></div></div>
          <div class="hd"><img src="/assets/sections/birdie-logo-white.svg" alt="Birdie" width="98" height="26" style="height:26px;width:auto" /></div>
          <div class="tx">{birdie.map((p) => <p>{p}</p>)}</div>
        </div>
      )}
    </div>
    {verdict && (
      <div class="sx-vbox"><h3>Verdict<img src="/assets/sections/minus.svg" alt="" /></h3><p>{verdict}</p></div>
    )}
  </div>
</section>
