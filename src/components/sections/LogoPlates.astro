---
/**
 * Grid of logo plates — Figma "Features / Option 6" (compare hub + "Compare Birdie to other platforms").
 * Props: heading (optional), items [{slug, name, href}] (slug selects the logo from data/compareLogos), cols fixed by CSS (5 / 2 on mobile).
 * Each plate keeps its "Birdie vs {name}" link text as screen-reader/SEO text.
 */
import '../../styles/sections.css';
import Logo from './Logo.astro';
export interface Props { heading?: string; items: { slug: string; name: string; href: string; label?: string }[]; flush?: boolean; id?: string; }
const { heading, items, flush = false, id } = Astro.props;
---
<section class="hm-sec hm-white hm-stack" style={flush ? 'padding-top:0' : undefined} id={id}>
  {heading && <div class="hm-intro"><h2 class="hm-h2">{heading}<i>.</i></h2></div>}
  <div class="sx-plates">
    {items.map((it) => (
      <a class="sx-plate" href={it.href}><Logo slug={it.slug} maxW={160} maxH={56} /><span class="sr-only">{it.label ?? `Birdie vs ${it.name}`}</span></a>
    ))}
  </div>
  <slot />
</section>
