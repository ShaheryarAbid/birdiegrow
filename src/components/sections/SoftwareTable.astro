---
/**
 * Wide multi-column comparison table (Figma comparison-table styling, scrolls horizontally on small screens). With hl, the first body row is highlighted dark (Birdie).
 * Props: heading, headers string[], rows string[][] (cells are HTML strings), note (small paragraph under the table).
 */
import { gd } from '../../lib/gd';
import '../../styles/sections.css';
export interface Props { heading: string; headers: string[]; rows: string[][]; note?: string; id?: string; hl?: boolean; }
const { heading, headers, rows, note, id, hl = false } = Astro.props;
const endsPunct = /[.?!]$/.test(heading.trim());
---
<section class="hm-sec hm-white hm-stack" id={id}>
  <div class="hm-intro"><h2 class="hm-h2" set:html={gd(heading)} /></div>
  <div class="sx-tbl sx-tbl--wide">
    <div class="sx-tbl__scroll" tabindex="0" role="region" aria-label={heading}>
      <table>
        <thead><tr>{headers.map((h) => <th scope="col">{h}</th>)}</tr></thead>
        <tbody>{rows.map((r, ri) => (<tr class={hl && ri === 0 ? 'hl' : undefined}>{r.map((c, ci) => (ci === 0 ? <th scope="row" set:html={c} /> : <td set:html={c} />))}</tr>))}</tbody>
      </table>
    </div>
  </div>
  {note && <p class="hm-sub">{note}</p>}
</section>
