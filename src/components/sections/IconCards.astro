---
/**
 * 2x2 icon cards — Figma "Features / Option 3" 371:20172 (first card has the dark shader icon tile).
 * Props: heading, items [{title, text, label, href}] (label = link text; a trailing "→" is stripped, the arrow icon is drawn),
 * icons (optional file names in /assets/seo/, default laptop/money/door/chart).
 */
import { gd } from '../../lib/gd';
import '../../styles/sections.css';
import { SHADER_DARK } from '../../data/shader';
export interface Props {
  heading: string;
  items: { title: string; text: string; label: string; href: string }[];
  icons?: string[];
  id?: string;
  h2Classes?: string;
}
const { heading, items, icons = ['icon-laptop', 'icon-money', 'icon-door', 'icon-chart'], h2Classes, id } = Astro.props;
const S = '/assets/seo/';
const clean = (s: string) => s.replace(/\s*→\s*$/, '');
const endsPunct = /[.?!]$/.test(heading.trim());
---
<section class="hm-sec hm-white hm-stack" id={id}>
  <div class="hm-intro"><h2 class=`hm-h2 ${h2Classes}` set:html={gd(heading)} /></div>
  <div class="sx-ic">
    {items.map((it, i) => (
      <article class={`sx-ic__card${i === 0 ? ' is-first' : ''}`}>
        <div class={`sx-ic__tile${i === 0 ? ' dark' : ''}`} aria-hidden="true">
          <img class="g" src={`${S}${icons[i % icons.length]}.svg`} alt="" width="40" height="40" />
        </div>
        <div class="sx-ic__txt"><h3>{it.title}</h3><p>{it.text}</p></div>
        <a class="sx-ic__link" href={it.href}>{clean(it.label)}<img src={`${S}arrow.svg`} alt="" width="16" height="16" /></a>
      </article>
    ))}
  </div>
</section>
