---
/** A competitor logo (Figma logo-plate content) scaled to fit maxW x maxH. */
import { COMPARE_LOGOS } from '../../data/compareLogos';
export interface Props { slug: string; alt?: string; maxW?: number; maxH?: number; mono?: 'white' | 'black'; class?: string; }
const { slug, alt = '', maxW, maxH, mono, class: cls = '' } = Astro.props;
const spec = COMPARE_LOGOS[slug];
const k = spec ? Math.min(maxW ? maxW / spec.w : 1, maxH ? maxH / spec.h : 1) : 1;
const W = spec ? +(spec.w * k).toFixed(2) : 0;
const H = spec ? +(spec.h * k).toFixed(2) : 0;
const pct = (v: number, t: number) => `${((v / t) * 100).toFixed(3)}%`;
---
{spec && (
  <span class={`sx-logo${mono ? ` sx-logo--${mono}` : ''} ${cls}`.trim()} style={`width:${W}px;height:${H}px`} role={alt ? 'img' : undefined} aria-label={alt || undefined}>
    {spec.parts.map((p) => (
      <img src={p.src} alt="" loading="lazy" style={`left:${pct(p.x, spec.w)};top:${pct(p.y, spec.h)};width:${pct(p.w, spec.w)};height:${pct(p.h, spec.h)}${p.pos ? ';object-position:bottom' : ''}`} />
    ))}
  </span>
)}
