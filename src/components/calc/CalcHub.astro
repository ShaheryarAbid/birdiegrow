---
/**
 * Calculators hub — Figma Calculators 272:22015. H1 left / intro right, 2x2 tool cards (icon tile, title, text, "Open Calculator"), dark explainer band.
 * Props: h1, lead, tools [name, description, href, icon ('store' | 'revenue' | 'scales' | 'card')][], explainer {heading, paras (HTML strings)}.
 * Breadcrumb ("Home · Resources · Calculators") is kept above the heading.
 */
import '../../styles/sections.css';
import '../../styles/calc.css';
import Button from '../Button.astro';
import { SHADER_DARK } from '../../data/shader';
export interface Props { h1: string; lead: string; tools: [string, string, string, string][]; explainer: { heading: string; paras: string[] }; }
const { h1, lead, tools, explainer } = Astro.props;
const endsPunct = /[.?!]$/.test(h1.trim());
const R = '/assets/resources/';
const ico: Record<string, string> = {
  revenue: '<circle cx="14" cy="24" r="9"/><path d="M14 20v8M16.5 21.5c-.5-.8-1.5-1.2-2.5-1.2-1.4 0-2.5.8-2.5 1.9s1.1 1.6 2.5 1.9 2.5.8 2.5 1.9-1.1 1.9-2.5 1.9c-1 0-2-.4-2.5-1.2"/><path d="M28 18V6m0 0-4 4m4-4 4 4"/>',
  scales: '<path d="M20 6v26M12 34h16M8 12h24"/><path d="m8 12-5 12a5 5 0 0 0 10 0L8 12zM32 12l-5 12a5 5 0 0 0 10 0l-5-12z"/>',
  card: '<rect x="4" y="9" width="32" height="22" rx="4"/><circle cx="14" cy="19" r="3.5"/><path d="M8.5 26.5c.8-2.2 2.8-3.5 5.5-3.5s4.7 1.3 5.5 3.5M24 17h8M24 22h8"/>',
};
---
<div class="hm cc">
  <section class="cc-head">
    <p class="cc-crumb"><a href="/">Home</a> · <a href="/resources/">Resources</a> · Calculators</p>
    <div class="cc-head__row">
      <h1>{h1}{!endsPunct && <i>.</i>}</h1>
      <p class="cc-lead">{lead}</p>
    </div>
  </section>
  <section class="cc-sec">
    <div class="cc-tools">
      {tools.map(([name, desc, href, icon]) => (
        <a class="cc-tool" href={href}>
          {icon === 'store' ? (
            <span class="cc-tile cc-tile--dark"><img class="bg" src={`${R}tile-bg.webp`} alt="" /><div class="hm-shader hm-shader--soft" data-shader-params={SHADER_DARK}><div class="px"></div></div><img class="g" src={`${R}storefront.svg`} alt="" width="33" height="31" /></span>
          ) : (
            <span class="cc-tile"><svg viewBox="0 0 40 40" width="40" height="40" fill="none" stroke="#4b5563" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ico[icon]}></svg></span>
          )}
          <h2>{name}</h2>
          <p>{desc}</p>
          <span class="cc-tool__go">Open Calculator<img src="/assets/home/arrow-right-dark.svg" alt="" width="16" height="16" /></span>
        </a>
      ))}
    </div>
  </section>
  <section class="cc-sec cc-sec--last">
    <div class="cc-explain">
      <div class="cc-explain__bg" aria-hidden="true">
        <img src="/assets/home/cta-image.webp" alt="" loading="lazy" />
        <div class="fade"></div>
        <div class="hm-shader hm-shader--soft" data-shader-params={SHADER_DARK}><div class="px"></div></div>
      </div>
      <div class="cc-explain__h"><h2>{explainer.heading}</h2><Button href="/demo/" mode="light">Book a demo</Button></div>
      <div class="cc-explain__t">{explainer.paras.map((p) => <p set:html={p} />)}</div>
    </div>
  </section>
</div>
