---
/**
 * Plan tiers row — Figma "Features / Option 9". Props: heading, sub, tiers [name, text, price][], note, cta {label, href}, id.
 */
import { gd } from '../../lib/gd';
import '../../styles/sections.css';
import '../../styles/product.css';
import Button from '../Button.astro';
export interface Props { heading: string; sub?: string; tiers: [string, string, string][]; note?: string; cols?: 2 | 3 | 4; cta?: { label: string; href: string }; id?: string; }
const { heading, sub, tiers, note, cols = 3, cta, id } = Astro.props;
const endsPunct = /[.?!]$/.test(heading.trim());
---
<section class="hm-sec hm-white hm-stack" id={id}>
  <div class="hm-intro"><h2 class="hm-h2" set:html={gd(heading)} />{sub && <p class="hm-sub" style="max-width:640px">{sub}</p>}{cta && <Button href={cta.href} mode="dark">{cta.label}</Button>}</div>
  <div class={`pf-tiers${cols === 4 ? ' pf-tiers--4' : cols === 2 ? ' pf-tiers--2' : ''}`}>{tiers.map(([n, t, p]) => <div class="pf-tier"><div><h3>{n}</h3><p>{t}</p></div><div class="amt" set:html={p.replace(/(\/\s?mo(nth)?)$/i, '<i>$1</i>')} /></div>)}</div>
  {note && <p class="pf-tier-note">{note}</p>}
</section>
