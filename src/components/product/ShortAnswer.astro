---
/**
 * "The short answer." section — Figma 2049:103131 (mobile 2049:103842). Copy and an icon list on the left, an image on the right.
 * Props: heading, body / bodyHtml, chips (label, or [icon name from data/icons.ts, label]; a plain label gets a check icon),
 * image {src, mobileSrc, mobileHeight, alt} (src on desktop and tablet, mobileSrc below 600px; mobileHeight is its pixel height at 542 wide, default 804), id.
 */
import { gd } from '../../lib/gd';
import '../../styles/sections.css';
import '../../styles/product.css';
import Icon from '../Icon.astro';
export interface Props {
  heading?: string;
  body?: string;
  bodyHtml?: string;
  chips?: (string | [string, string])[];
  image: { src: string; mobileSrc: string; mobileHeight?: number; alt: string };
  id?: string;
}
const { heading = 'The short answer', body, bodyHtml, chips = [], image, id } = Astro.props;
const rows = chips.map((c) => (typeof c === 'string' ? ['check', c] : c));
---
<section class="hm-sec hm-white" id={id}>
  <div class="pf-short">
    <div class="pf-short__copy">
      <h2 class="hm-h2" set:html={gd(heading)} />
      {body && <p class="hm-sub">{body}</p>}
      {bodyHtml && <p class="hm-sub" set:html={bodyHtml} />}
      {rows.length > 0 && <ul class="pf-chips">{rows.map(([ic, label]) => <li><span class="pf-chips__ic"><Icon name={ic} size={18} /></span>{label}</li>)}</ul>}
    </div>
    <picture class="pf-short__img">
      <source media="(max-width: 599px)" srcset={image.mobileSrc} width="542" height={image.mobileHeight ?? 804} />
      <img src={image.src} alt={image.alt} width="1200" height="836" loading="lazy" decoding="async" />
    </picture>
  </div>
</section>
