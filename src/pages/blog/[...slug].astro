---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleLayout from '../../components/sections/ArticleLayout.astro';
import GuideCards from '../../components/sections/GuideCards.astro';
import Cta from '../../components/sections/Cta.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../consts';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await post.render();
const minutes = Math.max(1, Math.ceil(post.body.trim().split(/\s+/).length / 200));
const related = (await getCollection('blog'))
  .filter((p) => p.slug !== post.slug)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4)
  .map((p) => ({ title: p.data.title, desc: p.data.description, href: `/blog/${p.slug}/`, category: 'Blog' }));
const schema = [{
  '@context': 'https://schema.org', '@type': 'BlogPosting',
  headline: post.data.title, description: post.data.description,
  image: new URL(SITE.ogImage, SITE.url).href,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
  author: { '@type': 'Organization', name: 'Birdie' },
  publisher: { '@type': 'Organization', name: 'Birdie' },
}];
---
<BaseLayout title={`${post.data.title} | Birdie`} description={post.data.description} type="article" schema={schema} headerVariant="light">
  <ArticleLayout kind="Blog" hubHref="/blog/" title={post.data.title} intro={post.data.description} pubDate={post.data.pubDate} updatedDate={post.data.updatedDate} minutes={minutes}>
    <Content />
  </ArticleLayout>
  {related.length > 0 && <GuideCards heading="Keep reading" items={related} />}
  <Cta label="Book a Demo" />
</BaseLayout>
