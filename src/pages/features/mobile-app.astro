---
/**
 * Mobile app feature page — /features/mobile-app/ (Figma "Mobile app: feature page", node 558:36707). Content lives in src/data/features/mobileApp.ts.
 * NOT LINKED, NOT INDEXED: the mobile app is deliberately absent from src/data/features.ts (not verified as offered), the Figma
 * store buttons have no real URLs and the Figma prices are not confirmed (the annual ones are placeholders). The page is built so it can go live once confirmed:
 * remove `noindex`, add the store URLs to `hero.badges` in the data file, and drop the sitemap exclusion in astro.config.mjs.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductHero from "../../components/product/ProductHero.astro";
import FeaturesAppScreensTabs from "../../components/sections/FeaturesAppScreensTabs.astro";
import TiersSectionMobileApp from "../../components/sections/TiersSectionMobileApp.astro";
import Cta from "../../components/sections/Cta.astro";
import { MOBILE_APP } from "../../data/features/mobileApp";

const { meta, hero, screens, plans, cta } = MOBILE_APP;
---

<BaseLayout
  title={meta.title}
  description={meta.description}
  noindex
  headerVariant="dark"
  headerOverlay
>
  <div class="hm mobile-app-page">
    <ProductHero wide {...hero} />
    <FeaturesAppScreensTabs {...screens} id="product" />
    <TiersSectionMobileApp {...plans} />
    <Cta {...cta} items={[]} />
  </div>
  <style is:global>
    /* Hero: Figma pr-hero photo as the full-bleed background (desktop art, separate mobile art) */
    .mobile-app-page .pf-hero {
      background: #000407
        url("/assets/features/mobile-app/mobile-app-product-hero.webp") center /
        cover no-repeat;
    }
    @media (max-width: 900px) {
      .mobile-app-page .pf-hero {
        background: #000407 url("/assets/features/po-hero-mobile.webp") center
          45% / cover no-repeat;
      }
      .pf-hero__badges {
        flex-direction: row;
      }
      .pf-hero h1,
      .pf-hero__lead {
        max-width: 100%;
      }
    }
    @media (max-width: 540px) {
      .mobile-app-page .pf-hero {
        background-position: center 25%;
      }
    }
  </style>
</BaseLayout>
