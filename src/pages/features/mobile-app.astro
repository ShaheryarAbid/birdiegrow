---
/**
 * Mobile app feature page — /features/mobile-app/ (Figma "Mobile app: feature page", node 558:36707).
 * NOT LINKED, NOT INDEXED: the mobile app is deliberately absent from src/data/features.ts (not verified as offered), the Figma
 * store buttons have no real URLs and the Figma prices below are not confirmed (the annual ones are placeholders). The page is built so it can go live once confirmed:
 * remove `noindex`, add the store URLs to `badges`, and drop the sitemap exclusion in astro.config.mjs.
 */
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductHero from "../../components/product/ProductHero.astro";
import FeaturesAppScreensTabs from "../../components/sections/FeaturesAppScreensTabs.astro";
import TiersSectionMobileApp from "../../components/sections/TiersSectionMobileApp.astro";
import Cta from "../../components/sections/Cta.astro";
import { SITE } from "../../consts";

const title = "Mobile App for Golf Simulator Venues | Birdie";
const description =
  "The Birdie mobile app puts your venue on every golfer’s phone: book bays, join leagues and manage an account, with the same bays, prices and rules as your booking page.";
const F = "/assets/features/";
// Annual prices are placeholders (monthly x 12): the design only shows monthly prices. Replace them with the real ones.
const tiers = [
  {
    name: "Booking System + Mobile app",
    tagline: "Everything you need, plus your app",
    price: { monthly: "$247", annually: "$2,964" },
    dark: true,
    background: `${F}mobile-app/plan-bg.webp`,
    billingTabs: true,
    features: [
      "Bay booking calendar",
      "Membership plans with hour tracking",
      "Add-ons (BYOB, guests, custom items)",
      "Automated text and email confirmations, reminders and receipts",
      "Stripe, Square, Clover and Helcim (beta) payments",
      "Customer database",
      "Occupancy tracking",
    ],
  },
  {
    name: "Booking + Website",
    tagline: "Your booking system with a conversion-ready site",
    price: { monthly: "From $50", annually: "From $600" },
    featuresLead: "Added to your current plan +",
    features: [
      "iOS and Android app for your golfers",
      "Bay booking, leagues and profile in the app",
      "Same bays, prices and rules as your booking page",
    ],
  },
];

// Fill in each `src` as the screens are added, e.g. `${F}app-tabs/book-1.webp`. An empty `src` shows a placeholder.
const appScreens = [
  {
    label: "Book a bay",
    slides: [
      {
        src: `${F}mobile-app/booking-bat-session.webp`,
        width: 441,
        height: 780,
        alt: "Choosing a date, time and bay in the Birdie app",
      },
      {
        src: `${F}mobile-app/add-extras.webp`,
        width: 441,
        height: 780,
        alt: "Adding extras to a booking in the Birdie app",
      },
      {
        src: `${F}mobile-app/contact-details.webp`,
        width: 441,
        height: 780,
        alt: "Entering contact details in the Birdie app",
      },
      {
        src: `${F}mobile-app/booking-summary.webp`,
        width: 441,
        height: 780,
        alt: "Booking summary in the Birdie app",
      },
    ],
  },
  {
    label: "Join a league",
    slides: [
      {
        src: `${F}mobile-app/leagues.webp`,
        alt: "Browsing available leagues in the Birdie app",
      },
      {
        src: `${F}mobile-app/league-details.webp`,
        alt: "Viewing a league's season, schedule and location in the Birdie app",
      },
      {
        src: `${F}mobile-app/team-details.webp`,
        alt: "Registering a team for a league in the Birdie app",
      },
      {
        src: `${F}mobile-app/team-roaster.webp`,
        alt: "Adding players to a team roster in the Birdie app",
      },
    ],
  },
  {
    label: "Profile",
    slides: [
      {
        src: `${F}mobile-app/profile-overview.webp`,
        alt: "Profile overview with account credit and upcoming bookings in the Birdie app",
      },
      {
        src: `${F}mobile-app/profile-plans.webp`,
        alt: "Active membership plans and remaining hours in the Birdie app",
      },
      {
        src: `${F}mobile-app/profile-explore.webp`,
        alt: "Exploring upcoming events and leagues in the Birdie app",
      },
      {
        src: `${F}mobile-app/profile-details.webp`,
        alt: "Profile details, account settings and wallet in the Birdie app",
      },
    ],
  },
];
---

<BaseLayout
  title={title}
  description={description}
  noindex
  headerVariant="dark"
  headerOverlay
>
  <div class="hm mobile-app-page">
    <ProductHero
      wide
      crumb={["Product", "Mobile app"]}
      h1="Your venue. In every golfer's pocket."
      lead="The Birdie mobile app for iOS and Android. Golfers book bays, join leagues and manage their account — your venue, one tap away."
      badges={[
        {
          small: "Download on the",
          label: "App Store",
          image: "/assets/icons/apple-brand.png",
          imageSide: "left",
          imageWidth: 20,
          imageHeight: 24,
        },
        {
          small: "GET IT ON",
          label: "Google Play",
          image: "/assets/icons/playstore.svg",
          imageSide: "left",
          imageWidth: 20,
          imageHeight: 24,
        },
      ]}
    />

    <FeaturesAppScreensTabs
      heading="What golfers see."
      sub="The same bays, prices and rules you set in Birdie — in an app on your customers' phones. Three things they do most."
      tabs={appScreens}
      id="product"
    />


    <TiersSectionMobileApp
      heading="Add the app to your plan."
      sub="Two ways to get it. Add the app to the Booking System you already run, or start on the plan that includes it."
      buttons={[
        { text: "Book a demo", href: SITE.demoPath, mode: "dark" },
        {
          text: "See the booking system",
          href: "/features/bay-booking/",
          mode: "light",
          hierarchy: "secondary",
          icon: "/assets/home/arrow-right-dark.svg",
        },
      ]}
      tiers={tiers}
      benefits={["No long-term contracts", "Live in 24 hours", "We handle all setup"]}
    />

    <Cta
      heading="Put your venue on their home screen."
      body="Free walkthrough. No commitment. We handle all setup."
      items={[]}
    />
  </div>
  <style is:global>
    /* Hero: Figma pr-hero photo as the full-bleed background (desktop art, separate mobile art) */
    .mobile-app-page .pf-hero {
      background: #000407
        url("/assets/features/mobile-app/mobile-app-product-hero.webp") center /
        cover no-repeat;
    }
    @media (max-width: 900px) {
      .mobile-app-page .pf-hero {
        background: #000407 url("/assets/features/po-hero-mobile.webp") center
          45% / cover no-repeat;
      }
      .pf-hero__badges {
        flex-direction: row;
      }
      .pf-hero h1,
      .pf-hero__lead {
        max-width: 100%;
      }
    }
    @media (max-width: 540px) {
      .mobile-app-page .pf-hero {
        background-position: center 25%;
      }
    }
  </style>
</BaseLayout>
