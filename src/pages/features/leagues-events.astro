---
/** Leagues & events — /features/leagues-events/ (Figma "Leagues & events", node 314:22300). Content lives in src/data/features/leagues-events.ts. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductHero from '../../components/product/ProductHero.astro';
import ShortAnswer from '../../components/product/ShortAnswer.astro';
import LeaguePlanner from '../../components/product/LeaguePlanner.astro';
import FormatTabs from '../../components/product/FormatTabs.astro';
import SetupTimeline from '../../components/sections/SetupTimeline.astro';
import LinkCards from '../../components/sections/LinkCards.astro';
import Glance from '../../components/sections/Glance.astro';
import Faq from '../../components/sections/Faq.astro';
import Cta from '../../components/sections/Cta.astro';
import { LEAGUES_EVENTS } from '../../data/features/leagues-events';

const { meta, hero, shortAnswer, planner, formats, timeline, faq, links, cta } = LEAGUES_EVENTS;
const schema = [{ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.items.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) }];
---
<BaseLayout title={meta.title} description={meta.description} schema={schema} headerVariant="dark" headerOverlay>
<div class="hm leagues-events-page">
  <ProductHero tall center {...hero} />
  <ShortAnswer {...shortAnswer} />

  <!-- League season planner — Figma 2049:102254 (mobile 2049:102760). Static example, not interactive. -->
  <LeaguePlanner {...planner} />

  <!-- Four formats — Figma 2049:102341 (tab 2: 2049:102483, mobile: 2049:102850) -->
  <FormatTabs {...formats} />

  <!-- League-night timeline — Figma 2049:102426 (mobile 2049:102939). Same scroll-progress component as the home page. -->
  <SetupTimeline {...timeline} />

  <Glance />
  <Faq {...faq} />
  <LinkCards {...links} />
  <Cta {...cta} />
</div>
<style is:global>
    /* Hero: Figma pr-hero photo as the full-bleed background (desktop art, separate mobile art) */
    .leagues-events-page .pf-hero {
      background: #000407
        url("/assets/features/leagues-events-bg.webp") center /
        cover no-repeat;
    }
    .leagues-events-page .pf-hero__art { display: none; }
    @media (max-width: 900px) {
      .leagues-events-page .pf-hero {
        background: #000407 url("/assets/features/leagues-events-bg-mobile.webp") center center / cover no-repeat;
      }
      .leagues-events-page .pf-hero--tall {
        min-height: 800px;
      }
    }
  </style>
</BaseLayout>
