---
/**
 * /demo/ — Figma "/demo" 546:35925 (dark funnel hero with the walkthrough form, benefits, app screens, customer stories, call agenda, FAQ, CTA).
 * Content lives in src/data/demo.ts. The form is unchanged in behaviour: honeypot, masks, POST /api/lead, Lead conversions (Meta / GA4 / Google Ads / Reddit), sessionStorage hand-off, redirect to /book-demo/.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingBg from '../components/booking/BookingBg.astro';
import BookingBar from '../components/booking/BookingBar.astro';
import CustomerStories from '../components/sections/CustomerStories.astro';
import Faq from '../components/sections/Faq.astro';
import Cta from '../components/sections/Cta.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import '../styles/booking.css';
import '../styles/pages.css';
import { ANALYTICS } from '../consts';
import { gd } from '../lib/gd';
import { DEMO } from '../data/demo';
import { SHADER_DARK } from '../data/shader';
import FeaturesSlider from '../components/FeaturesSlider.astro';
import { FEATURE_SLIDER_DESIGN } from '../components/sections/FeaturesAppScreensTabs.astro';

const { sliderOptions } = Astro.props;
const { meta, contactEmail, hero, form, benefits, screens, stories, call, faq, cta } = DEMO;
const options = { ...FEATURE_SLIDER_DESIGN, ...sliderOptions };
---
<BaseLayout title={meta.title} description={meta.description} noHeader={true}>
  <div class="bk bk--demo">
    <!-- <BookingBg /> -->
    <BookingBar variant="actions" />
    <h1 class="bk-demo-h1" set:html={gd(hero.h1)} />
    <p class="bk-sub">{hero.sub}</p>

    <div class="bk-demo">
      <div class="bk-df">
        <h2>{form.heading}</h2>
        <form id="demo-form" method="post" action="/api/lead">
          <!-- honeypot: hidden from humans, catches bots -->
          <input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
          <div class="row">
            <div class="f"><label for="demo-first">{form.firstName.label} <span class="req">*</span></label><input id="demo-first" type="text" name="first_name" placeholder={form.firstName.placeholder} autocomplete="given-name" required /></div>
            <div class="f"><label for="demo-biz">{form.businessName.label} <span class="req">*</span></label><input id="demo-biz" type="text" name="business_name" placeholder={form.businessName.placeholder} autocomplete="organization" required /></div>
          </div>
          <div class="f"><label for="demo-email">{form.email.label} <span class="req">*</span></label><input id="demo-email" type="email" name="email" placeholder={form.email.placeholder} autocomplete="email" required /></div>
          <div class="row">
            <div class="f"><label for="demo-phone">{form.phone.label} <span class="req">*</span></label><input type="tel" name="phone" id="demo-phone" inputmode="numeric" maxlength="14" title={form.phone.title} placeholder={form.phone.placeholder} autocomplete="tel" required /></div>
            <div class="f"><label for="demo-zip">{form.zip.label} <span class="req">*</span></label><input type="text" name="zip" id="demo-zip" inputmode="numeric" maxlength="5" title={form.zip.title} placeholder={form.zip.placeholder} autocomplete="postal-code" required /></div>
          </div>
          <div class="f">
            <span class="lab">{form.interests.label}</span>
            <div class="opts">
              {form.interests.options.map((i) => <button type="button" class="demo-opt" data-val={i} aria-pressed="false">{i}</button>)}
            </div>
            <input type="hidden" name="interests" id="demo-interests" />
          </div>
          <button id="demo-submit" type="submit" class="bk-cta">{form.submit}</button>
          <p id="demo-error" class="err" role="alert" style="display:none">{form.error} <a href={`mailto:${contactEmail}`}>{contactEmail}</a>.</p>
        </form>
        <div id="demo-success" class="ok" style="display:none">
          <h3>{form.success.heading}</h3>
          <p>{form.success.body} <a href={form.success.link.href}>{form.success.link.text}</a></p>
        </div>
      </div>
      <div class="bk-proof">
        <div class="stars" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 24 24"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17.3 5.8 20.9l1.6-7L2 9.2l7.1-.6z" /></svg>)}</div>
        <p>{hero.proof}</p>
      </div>
    </div>
  </div>

  <div class="hm">
    <section class="hm-sec hm-white hm-round pg-benefits">
      {benefits.map(({ icon, title, text }) => (
        <div class="pg-benefit">
          <span class="pg-ic" aria-hidden="true"><Icon name={icon} size={32} /></span>
          <div><h2>{title}</h2><p>{text}</p></div>
        </div>
      ))}
    </section>

    <section class="hm-sec hm-white pg-screens-sec">
        <FeaturesSlider label={`${screens.label} screens`} viewportClass="features-app-screens__card" options={options}>
          {screens.slides.map((slide) => slide.src
            ? <img class="features-app-screens__screen" src={slide.src} alt={slide.alt ?? ''} width={slide.width} height={slide.height} loading="lazy" decoding="async" />
            : <div class="features-app-screens__screen features-app-screens__screen--empty" aria-hidden="true"></div>)}
        </FeaturesSlider>
      </div>
    </section>

    <section class="hm-sec hm-white hm-stack pg-proof">
      <div class="hm-intro">
        <h2 class="hm-h2" set:html={gd(stories.heading)} />
        <p class="hm-sub" style="max-width:640px">{stories.sub}</p>
        <Button href={stories.link.href} mode="dark" hierarchy="secondary" class="bd-btn--secondary-light">{stories.link.text} <img src="/assets/home/arrow-right-dark.svg" alt="" width="16" height="16" /></Button>
        <br />
      </div>
    </section>
    <CustomerStories stories={stories.items} id="stories" />

    <section class="hm-sec hm-white hm-stack pg-call demo-call-info">
      <h2 class="hm-h2" set:html={gd(call.heading)} />
      <div class="pg-call__row">
        {call.steps.map(({ icon, title }) => (
          <article class="pg-call__card">
            <div class="sx-ic__tile dark" aria-hidden="true">
              <img class="art" src="/assets/seo/tile-art.webp" alt="" loading="lazy" />
              <div class="hm-shader hm-shader--soft" data-shader-params={SHADER_DARK}><div class="px"></div></div>
              <div class="hm-noise" style="background:#fdfffe"></div>
              <span class="g" style="color:#fff;display:grid;place-items:center"><Icon name={icon} size={32} /></span>
            </div>
            <h3>{title}</h3>
          </article>
        ))}
      </div>
      <p class="pg-note">{call.note} <a href={`mailto:${contactEmail}`}>{call.noteLink}</a></p>
    </section>

    <Faq {...faq} open={1} balls />
    <Cta {...cta} items={[]} />
  </div>

  <style is:global>
    /* Hero: Figma pr-hero photo as the full-bleed background (desktop art, separate mobile art) */
    .bk--demo {
      background: #000407
        url("/assets/features/demo-bg.webp") bottom /
        cover no-repeat;
    }
    .demo-call-info {
      gap: 24px;
    }
    .demo-call-info h2 {
      margin-bottom: 36px;
    }
    @media (max-width: 900px) {
      .demo-call-info h2 {
        margin-bottom: 16px;
      }
      .fb { display: none;}
      .hm-stack { padding: 56px 16px; }
      br { display: none; }
      .bk--demo {
      background: #000407
          url("/assets/features/demo-bg-mobile.webp") bottom /
          cover no-repeat;
      }
    }
  </style>

  {/* Fire the Lead conversion (Meta + GA4 + optional Google Ads) when the demo form is submitted. */}
  <script is:inline define:vars={{ adsLabel: ANALYTICS.googleAdsLeadLabel }}>
    (function () {
      var form = document.getElementById('demo-form');
      if (!form) return;

      // Phone mask → (000)-000-0000, digits only, max 10 digits.
      var phoneEl = document.getElementById('demo-phone');
      if (phoneEl) {
        // Set pattern here (backslashes survive in is:inline scripts, unlike HTML attrs).
        phoneEl.setAttribute('pattern', '\\(\\d{3}\\)-\\d{3}-\\d{4}');
        phoneEl.addEventListener('input', function () {
          var d = phoneEl.value.replace(/\D/g, '');
          if (d.length === 11 && d.charAt(0) === '1') d = d.slice(1);
          d = d.slice(0, 10);
          var out = '';
          if (d.length === 0) out = '';
          else if (d.length < 4) out = '(' + d;
          else if (d.length < 7) out = '(' + d.slice(0, 3) + ')-' + d.slice(3);
          else out = '(' + d.slice(0, 3) + ')-' + d.slice(3, 6) + '-' + d.slice(6);
          phoneEl.value = out;
        });
      }
      // Zip → digits only, exactly up to 5.
      var zipEl = document.getElementById('demo-zip');
      if (zipEl) {
        zipEl.setAttribute('pattern', '\\d{5}');
        zipEl.addEventListener('input', function () {
          zipEl.value = zipEl.value.replace(/\D/g, '').slice(0, 5);
        });
      }

      var btn = document.getElementById('demo-submit');
      var errorEl = document.getElementById('demo-error');
      var successEl = document.getElementById('demo-success');

      // Interests multi-select → hidden field (comma-separated).
      var picked = [];
      var interestsEl = document.getElementById('demo-interests');
      form.querySelectorAll('.demo-opt').forEach(function (opt) {
        opt.addEventListener('click', function () {
          var v = opt.getAttribute('data-val');
          var i = picked.indexOf(v);
          if (i === -1) { picked.push(v); opt.classList.add('is-sel'); }
          else { picked.splice(i, 1); opt.classList.remove('is-sel'); }
          opt.setAttribute('aria-pressed', String(i === -1));
          if (interestsEl) interestsEl.value = picked.join(', ');
        });
      });

      function fireConversions() {
        try { if (window.fbq) fbq('track', 'Lead'); } catch (e) {}
        try { if (window.gtag) gtag('event', 'generate_lead', { currency: 'USD', value: 0 }); } catch (e) {}
        try { if (window.gtag && adsLabel) gtag('event', 'conversion', { send_to: adsLabel, value: 1.0, currency: 'USD' }); } catch (e) {}
        try { if (window.rdt) rdt('track', 'Lead'); } catch (e) {}
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!form.reportValidity()) return;
        if (errorEl) errorEl.style.display = 'none';
        var original = btn ? btn.textContent : '';
        if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }

        var fd = new FormData(form);
        if (window.__birdieAttrApply) window.__birdieAttrApply(fd);
        fetch('/api/lead', { method: 'POST', body: fd })
          .then(function (r) { return r.json().catch(function () { return { ok: r.ok }; }); })
          .then(function (data) {
            if (data && data.ok) {
              fireConversions();
              // Stash the lead so /book-demo can include it in the booking alert.
              try {
                sessionStorage.setItem('birdie_lead', JSON.stringify({
                  first_name: (form.first_name || {}).value || '',
                  business_name: (form.business_name || {}).value || '',
                  email: (form.email || {}).value || '',
                  phone: (form.phone || {}).value || '',
                  zip: (form.zip || {}).value || '',
                  interests: (form.interests || {}).value || '',
                }));
              } catch (e) {}
              if (btn) btn.textContent = 'Opening scheduler…';
              // 700ms, not 250ms: Meta and Google send conversions on a beacon
              // transport that survives page unload, but Reddit's pixel uses a
              // plain image request. On a slow mobile connection 250ms is not
              // enough for it to leave the browser, and the Lead is lost silently.
              setTimeout(function () { window.location.href = '/book-demo/'; }, 700);
            } else {
              throw new Error('failed');
            }
          })
          .catch(function () {
            if (errorEl) errorEl.style.display = 'block';
            if (btn) { btn.disabled = false; btn.textContent = original; }
          });
      });
    })();
  </script>
</BaseLayout>
