---
/**
 * /demo/ — Figma "/demo" 546:35925 (dark funnel hero with the walkthrough form, benefits, app screens, customer stories, call agenda, FAQ, CTA).
 * The form is unchanged in behaviour: honeypot, masks, POST /api/lead, Lead conversions (Meta / GA4 / Google Ads / Reddit), sessionStorage hand-off, redirect to /book-demo/.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingBg from '../components/booking/BookingBg.astro';
import BookingBar from '../components/booking/BookingBar.astro';
import CustomerStories from '../components/sections/CustomerStories.astro';
import Faq from '../components/sections/Faq.astro';
import Cta from '../components/sections/Cta.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import '../styles/booking.css';
import '../styles/pages.css';
import { ANALYTICS } from '../consts';
import { PROOF } from '../data/proof';
import { TESTIMONIALS } from '../data/stories';
import { SOFTWARE_FAQS } from '../data/softwareFaq';
import { SHADER_DARK } from '../data/shader';
const title = 'Book a Free Demo — Birdie Golf Simulator Software';
const description = 'No pitch. No commitment. Just a live look at the platform built for golf simulator operators. Free walkthrough.';

const valueProps: [string, string, string][] = [
  ['calendar', '27% more weekday bookings', 'Average result for venues in their first 60 days on Birdie.'],
  ['rocket', 'Live in 24 hours', 'We handle the entire setup. You don’t need a developer or an IT person.'],
  ['filex', 'No long-term contracts', 'Month-to-month. If it doesn’t work, you cancel. Simple.'],
];
const steps: [string, string][] = [
  ['search', 'We look at your current setup'],
  ['play', 'We show you the platform live'],
  ['thumb', 'You decide if it’s a fit — zero pressure'],
];
// Figma shows three stories (featured + two); the YouTube facade loads the real video on click.
const IMG = ['story-1', 'story-2', 'story-3'];
const stories = TESTIMONIALS.slice(0, 3).map((t, i) => ({ ...t, img: `/assets/customers/${IMG[i]}.webp` }));
const interests = ['Booking System', 'Paid Advertising', 'Not Sure'];
---
<BaseLayout title={title} description={description} noHeader={true}>
  <div class="bk bk--demo">
    <BookingBg />
    <BookingBar variant="actions" />
    <h1 class="bk-demo-h1">The Booking System Built to Fill Your Bays<i>.</i></h1>
    <p class="bk-sub">A Booking System that grows with your business.</p>

    <div class="bk-demo">
      <div class="bk-df">
        <h2>Book Your Free Walkthrough</h2>
        <form id="demo-form" method="post" action="/api/lead">
          <!-- honeypot: hidden from humans, catches bots -->
          <input type="text" name="company_website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />
          <div class="row">
            <div class="f"><label for="demo-first">First Name <span class="req">*</span></label><input id="demo-first" type="text" name="first_name" placeholder="John" autocomplete="given-name" required /></div>
            <div class="f"><label for="demo-biz">Business Name <span class="req">*</span></label><input id="demo-biz" type="text" name="business_name" placeholder="Your venue" autocomplete="organization" required /></div>
          </div>
          <div class="f"><label for="demo-email">Email <span class="req">*</span></label><input id="demo-email" type="email" name="email" placeholder="john@example.com" autocomplete="email" required /></div>
          <div class="row">
            <div class="f"><label for="demo-phone">Phone <span class="req">*</span></label><input type="tel" name="phone" id="demo-phone" inputmode="numeric" maxlength="14" title="Enter a 10-digit US phone in the format (000)-000-0000" placeholder="(555)-123-4567" autocomplete="tel" required /></div>
            <div class="f"><label for="demo-zip">Zip Code <span class="req">*</span></label><input type="text" name="zip" id="demo-zip" inputmode="numeric" maxlength="5" title="Enter a 5-digit ZIP code" placeholder="90210" autocomplete="postal-code" required /></div>
          </div>
          <div class="f">
            <span class="lab">What are you interested in?</span>
            <div class="opts">
              {interests.map((i) => <button type="button" class="demo-opt" data-val={i} aria-pressed="false">{i}</button>)}
            </div>
            <input type="hidden" name="interests" id="demo-interests" />
          </div>
          <button id="demo-submit" type="submit" class="bk-cta">Submit</button>
          <p id="demo-error" class="err" role="alert" style="display:none">Something went wrong - please try again, or email <a href="mailto:luke@birdiegrow.com">luke@birdiegrow.com</a>.</p>
        </form>
        <div id="demo-success" class="ok" style="display:none">
          <h3>You’re all set.</h3>
          <p>Thanks — we’ve got your details and will reach out within one business day to confirm your walkthrough. Prefer to grab a time now? <a href="/book-demo/">Pick a slot →</a></p>
        </div>
      </div>
      <div class="bk-proof">
        <div class="stars" aria-hidden="true">{[0, 1, 2, 3, 4].map(() => <svg viewBox="0 0 24 24"><path d="M12 2l2.9 6.6 7.1.6-5.4 4.7 1.6 7L12 17.3 5.8 20.9l1.6-7L2 9.2l7.1-.6z" /></svg>)}</div>
        <p>Trusted by {PROOF.activeClients}+ Golf Simulators Nationwide</p>
      </div>
    </div>
  </div>

  <div class="hm">
    <section class="hm-sec hm-white hm-round pg-benefits">
      {valueProps.map(([ic, t, d]) => (
        <div class="pg-benefit">
          <span class="pg-ic" aria-hidden="true"><Icon name={ic} size={32} /></span>
          <div><h2>{t}</h2><p>{d}</p></div>
        </div>
      ))}
    </section>

    <section class="hm-sec hm-white pg-screens-sec">
      <div class="pg-screens"><img src="/assets/features/app-screens.webp" alt="Birdie booking flow on a phone: pick a date, time and bay, add extras, confirm the booking summary." width="1220" height="520" loading="lazy" /></div>
    </section>

    <section class="hm-sec hm-white hm-stack pg-proof">
      <div class="hm-intro">
        <h2 class="hm-h2">Trusted by venues like yours<i>.</i></h2>
        <p class="hm-sub" style="max-width:640px">From unattended 24/7 members’ clubs to full pub-and-kitchen golf venues — hear how operators across the country run bookings, memberships, and door access on Birdie.</p>
        <Button href="/customers/" mode="dark" hierarchy="secondary" class="bd-btn--secondary-light">See all customer stories <img src="/assets/home/arrow-right-dark.svg" alt="" width="16" height="16" /></Button>
      </div>
    </section>
    <CustomerStories stories={stories} id="stories" />

    <section class="hm-sec hm-white hm-stack pg-call">
      <h2 class="hm-h2">What Happens on the Call<i>.</i></h2>
      <div class="pg-call__row">
        {steps.map(([ic, t]) => (
          <article class="pg-call__card">
            <div class="sx-ic__tile dark" aria-hidden="true">
              <img class="art" src="/assets/seo/tile-art.webp" alt="" loading="lazy" />
              <div class="hm-shader hm-shader--soft" data-shader-params={SHADER_DARK}><div class="px"></div></div>
              <div class="hm-noise" style="background:#fdfffe"></div>
              <span class="g" style="color:#fff;display:grid;place-items:center"><Icon name={ic} size={32} /></span>
            </div>
            <h3>{t}</h3>
          </article>
        ))}
      </div>
      <p class="pg-note">Still have questions? <a href="mailto:luke@birdiegrow.com">Email us at luke@birdiegrow.com</a></p>
    </section>

    <Faq heading="Frequently asked questions" items={SOFTWARE_FAQS} open={1} balls />
    <Cta heading="Ready to see golf simulator software built for your studio?" body="Free walkthrough · No commitment · Live in 24 hours" items={[]} label="Book a demo" href="#demo-form" />
  </div>

  {/* Fire the Lead conversion (Meta + GA4 + optional Google Ads) when the demo form is submitted. */}
  <script is:inline define:vars={{ adsLabel: ANALYTICS.googleAdsLeadLabel }}>
    (function () {
      var form = document.getElementById('demo-form');
      if (!form) return;

      // Phone mask → (000)-000-0000, digits only, max 10 digits.
      var phoneEl = document.getElementById('demo-phone');
      if (phoneEl) {
        // Set pattern here (backslashes survive in is:inline scripts, unlike HTML attrs).
        phoneEl.setAttribute('pattern', '\\(\\d{3}\\)-\\d{3}-\\d{4}');
        phoneEl.addEventListener('input', function () {
          var d = phoneEl.value.replace(/\D/g, '');
          if (d.length === 11 && d.charAt(0) === '1') d = d.slice(1);
          d = d.slice(0, 10);
          var out = '';
          if (d.length === 0) out = '';
          else if (d.length < 4) out = '(' + d;
          else if (d.length < 7) out = '(' + d.slice(0, 3) + ')-' + d.slice(3);
          else out = '(' + d.slice(0, 3) + ')-' + d.slice(3, 6) + '-' + d.slice(6);
          phoneEl.value = out;
        });
      }
      // Zip → digits only, exactly up to 5.
      var zipEl = document.getElementById('demo-zip');
      if (zipEl) {
        zipEl.setAttribute('pattern', '\\d{5}');
        zipEl.addEventListener('input', function () {
          zipEl.value = zipEl.value.replace(/\D/g, '').slice(0, 5);
        });
      }

      var btn = document.getElementById('demo-submit');
      var errorEl = document.getElementById('demo-error');
      var successEl = document.getElementById('demo-success');

      // Interests multi-select → hidden field (comma-separated).
      var picked = [];
      var interestsEl = document.getElementById('demo-interests');
      form.querySelectorAll('.demo-opt').forEach(function (opt) {
        opt.addEventListener('click', function () {
          var v = opt.getAttribute('data-val');
          var i = picked.indexOf(v);
          if (i === -1) { picked.push(v); opt.classList.add('is-sel'); }
          else { picked.splice(i, 1); opt.classList.remove('is-sel'); }
          opt.setAttribute('aria-pressed', String(i === -1));
          if (interestsEl) interestsEl.value = picked.join(', ');
        });
      });

      function fireConversions() {
        try { if (window.fbq) fbq('track', 'Lead'); } catch (e) {}
        try { if (window.gtag) gtag('event', 'generate_lead', { currency: 'USD', value: 0 }); } catch (e) {}
        try { if (window.gtag && adsLabel) gtag('event', 'conversion', { send_to: adsLabel, value: 1.0, currency: 'USD' }); } catch (e) {}
        try { if (window.rdt) rdt('track', 'Lead'); } catch (e) {}
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        if (!form.reportValidity()) return;
        if (errorEl) errorEl.style.display = 'none';
        var original = btn ? btn.textContent : '';
        if (btn) { btn.disabled = true; btn.textContent = 'Sending…'; }

        var fd = new FormData(form);
        if (window.__birdieAttrApply) window.__birdieAttrApply(fd);
        fetch('/api/lead', { method: 'POST', body: fd })
          .then(function (r) { return r.json().catch(function () { return { ok: r.ok }; }); })
          .then(function (data) {
            if (data && data.ok) {
              fireConversions();
              // Stash the lead so /book-demo can include it in the booking alert.
              try {
                sessionStorage.setItem('birdie_lead', JSON.stringify({
                  first_name: (form.first_name || {}).value || '',
                  business_name: (form.business_name || {}).value || '',
                  email: (form.email || {}).value || '',
                  phone: (form.phone || {}).value || '',
                  zip: (form.zip || {}).value || '',
                  interests: (form.interests || {}).value || '',
                }));
              } catch (e) {}
              if (btn) btn.textContent = 'Opening scheduler…';
              // 700ms, not 250ms: Meta and Google send conversions on a beacon
              // transport that survives page unload, but Reddit's pixel uses a
              // plain image request. On a slow mobile connection 250ms is not
              // enough for it to leave the browser, and the Lead is lost silently.
              setTimeout(function () { window.location.href = '/book-demo/'; }, 700);
            } else {
              throw new Error('failed');
            }
          })
          .catch(function () {
            if (errorEl) errorEl.style.display = 'block';
            if (btn) { btn.disabled = false; btn.textContent = original; }
          });
      });
    })();
  </script>
</BaseLayout>
