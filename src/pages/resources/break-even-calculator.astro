---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalcShell from '../../components/calc/CalcShell.astro';
import Stepper from '../../components/calc/Stepper.astro';
const title = 'Golf Simulator Break-Even Calculator | Birdie';
const description = 'Find the utilization and bookings your golf simulator venue needs to break even — then see your monthly profit at any occupancy level.';

const schema = [{
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.birdiegrow.com/' },
    { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.birdiegrow.com/resources/' },
    { '@type': 'ListItem', position: 3, name: 'Break-Even Calculator', item: 'https://www.birdiegrow.com/resources/break-even-calculator/' },
  ],
}];

---
<BaseLayout title={title} description={description} schema={schema} headerVariant="light">
  <CalcShell
    h1="Golf Simulator Break-Even Calculator"
    lead="How busy do your bays actually need to be to turn a profit? Enter your costs and pricing to find the utilization rate that covers your bills — and see your monthly profit at any occupancy level."
    crumb="Break-Even Calculator"
    panelTitle="Your numbers"
    resultsTitle="Break-even utilization"
    ctaLabel="Fill more hours with Birdie — book a demo"
    explainer={{ heading: 'How to read your break-even number', paras: ['Your <strong>break-even utilization</strong> is the share of your available bay-hours you have to sell each month just to cover your fixed costs. Below it, you lose money; above it, every additional booked hour is profit. Most of the math comes down to your <em>contribution per hour</em> — your hourly rate minus the small variable cost of running a session. Fixed costs divided by that contribution gives the booked hours you need, and dividing by your total available hours turns that into a percentage.', 'The reason this number matters so much: simulator venues have high fixed costs and low variable costs, so profitability is almost entirely a utilization game. A studio stuck at 30% occupancy struggles while an identical one at 55% prints money — same rent, same equipment. That\'s why filling weekday and off-peak hours is the single highest-leverage thing an operator can do. See the tactics in <a href="/resources/how-to-fill-weekday-bays-golf-simulator/">how to fill weekday bays</a>, size the top line with the <a href="/resources/revenue-calculator/">revenue calculator</a>, or plan your launch budget with the <a href="/resources/startup-cost-calculator/">startup cost calculator</a>.'] }}
  >
    <Fragment slot="inputs">
      <Stepper id="fixed" label="Monthly fixed costs ($)" value={8000} min={0} step={100} prefix="$" hint="Rent, software, insurance, loan payments, base staff" />
      <Stepper id="bays" label="Number of bays" value={3} min={1} max={20} />
      <Stepper id="hours" label="Open hours per day" value={14} min={1} max={24} />
      <Stepper id="rate" label="Hourly rate ($)" value={45} min={1} step={1} prefix="$" />
      <Stepper id="varcost" label="Variable cost per booked hour ($)" value={3} min={0} step={1} prefix="$" hint="Utilities, cleaning, per-session consumables" />
      <Stepper id="target" label="Target utilization (%)" value={40} min={1} max={100} suffix="%" />
    </Fragment>
    <Fragment slot="results">
      <p class="cc-big"><span id="beUtil">0%</span></p>
      <p class="cc-sub"><span id="beHours">0</span> booked bay-hours per month</p>
      <div class="cc-split">
        <p class="cc-sec-t">Monthly profit at <span id="tLabel">40</span>% utilization</p>
        <p class="cc-big-sm"><span id="profit">$0</span></p>
        <p class="cc-sub muted" style="margin-top:6px"><span id="verdict"></span></p>
      </div>
      <p class="cc-sub cc-split">Total available bay-hours/month: <span id="avail">0</span></p>
    </Fragment>
  </CalcShell>

  <script is:inline>
    (function () {
      var $ = function (id) { return document.getElementById(id); };
      var fmt = function (n) { return (n < 0 ? '-$' : '$') + Math.abs(Math.round(n)).toLocaleString(); };
      function calc() {
        var fixed = +$('fixed').value || 0;
        var bays = +$('bays').value || 0;
        var hours = +$('hours').value || 0;
        var rate = +$('rate').value || 0;
        var varcost = +$('varcost').value || 0;
        var target = +$('target').value || 0;

        var avail = bays * hours * 30;
        var contribution = rate - varcost;
        var beHours = contribution > 0 ? fixed / contribution : 0;
        var beUtil = avail > 0 ? (beHours / avail) * 100 : 0;

        var bookedAtTarget = avail * (target / 100);
        var profit = bookedAtTarget * contribution - fixed;

        $('beUtil').textContent = (beUtil > 100 ? '>100' : Math.round(beUtil)) + '%';
        $('beHours').textContent = Math.round(beHours).toLocaleString();
        $('avail').textContent = Math.round(avail).toLocaleString();
        $('tLabel').textContent = Math.round(target);
        var pEl = $('profit');
        pEl.textContent = fmt(profit);
        pEl.style.color = profit >= 0 ? 'var(--accent, #1aa24c)' : '#ff6b6b';
        pEl.classList.toggle('accent', profit >= 0);
        $('verdict').textContent = profit >= 0
          ? 'Above break-even — this occupancy is profitable.'
          : 'Below break-even — you need higher utilization to cover costs.';
      }
      ['fixed', 'bays', 'hours', 'rate', 'varcost', 'target'].forEach(function (id) {
        var el = $(id);
        if (el) el.addEventListener('input', calc);
      });
      calc();
    })();
  </script>
</BaseLayout>
