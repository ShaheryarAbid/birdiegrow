---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalcHub from '../../components/calc/CalcHub.astro';
const title = 'Free Golf Simulator Business Calculators | Birdie';
const description = 'Free calculators for indoor golf simulator operators — estimate startup cost, break-even utilization, membership pricing, and monthly revenue.';

const tools = [
  ['Startup Cost Calculator', 'Estimate the all-in cost to open a venue — equipment, buildout, lease, and working capital — with a live breakdown by category.', '/resources/startup-cost-calculator/', 'store'],
  ['Revenue Calculator', 'Estimate monthly revenue from your bays, hourly rate, and utilization — and see the upside of filling weekday hours.', '/resources/revenue-calculator/', 'revenue'],
  ['Break-Even Calculator', 'Find the utilization and bookings you need to cover costs, then see your monthly profit at any occupancy level.', '/resources/break-even-calculator/', 'scales'],
  ['Membership Pricing Calculator', 'Model a membership plan — monthly recurring revenue, effective member rate vs drop-in pricing, and bay-hours consumed.', '/resources/membership-pricing-calculator/', 'card'],
];

const schema = [
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.birdiegrow.com/' },
      { '@type': 'ListItem', position: 2, name: 'Resources', item: 'https://www.birdiegrow.com/resources/' },
      { '@type': 'ListItem', position: 3, name: 'Calculators', item: 'https://www.birdiegrow.com/resources/calculators/' },
    ],
  },
  {
    '@context': 'https://schema.org', '@type': 'ItemList',
    itemListElement: tools.map((t, i) => ({
      '@type': 'ListItem', position: i + 1, name: t[0], url: `https://www.birdiegrow.com${t[2]}`,
    })),
  },
];
---
<BaseLayout title={title} description={description} schema={schema} headerVariant="light">
  <CalcHub
    h1="Golf Simulator Business Calculators"
    lead="Free, no-signup calculators for planning and running an indoor golf simulator venue — from what it costs to open, to what you'll make, to how to price memberships. Adjust the inputs to model your own numbers."
    tools={tools}
    explainer={{ heading: 'Plan the whole business, one number at a time', paras: ['Opening and running a profitable simulator venue comes down to a handful of numbers, and these four calculators walk you through them in order. Start with the <a href="/resources/startup-cost-calculator/">startup cost calculator</a> to size your investment, use the <a href="/resources/revenue-calculator/">revenue calculator</a> to estimate the top line, run the <a href="/resources/break-even-calculator/">break-even calculator</a> to find the utilization you actually need, and model recurring income with the <a href="/resources/membership-pricing-calculator/">membership pricing calculator</a>. Together they answer the questions every operator asks before and after opening the doors.', 'The calculators give you the math; the guides give you the playbook. If you\'re just getting started, read <a href="/resources/how-to-start-a-golf-simulator-business/">how to start a golf simulator business</a>. And when you\'re ready to run the venue on one platform — bookings, memberships, payments, and 24/7 access — <a href="/demo/">book a demo</a> to see how Birdie handles it.'] }}
  />
</BaseLayout>
