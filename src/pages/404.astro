---
/** 404 — Figma "404" 371:23119 (mobile 577:87087): dark golf-ball hero, centred message. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import '../styles/sections.css';
import '../styles/pages.css';
import { SHADER_DARK } from '../data/shader';
// Cloudflare Pages serves this 404.html with a real HTTP 404 status for unknown
// paths — killing the soft-404 (200) problem the SPA had. noindex is belt-and-suspenders.
---
<BaseLayout title="Page not found | Birdie" description="The page you were looking for doesn't exist." noindex={true} headerVariant="dark" headerOverlay>
  <div class="hm">
    <section class="pg-404">
      <div class="pg-404__bg" aria-hidden="true">
        <img src="/assets/pages/404-hero.webp" alt="" fetchpriority="high" />
        <div class="shade"></div>
        <div class="hm-shader hm-shader--soft" data-shader-params={SHADER_DARK}><div class="px"></div></div>
      </div>
      <div class="pg-404__c">
        <div>
          <h1>We couldn't find that page<i>.</i></h1>
          <p>The link may be broken or the page may have moved.</p>
        </div>
        <Button href="/" mode="light">Back to home</Button>
      </div>
    </section>
  </div>
</BaseLayout>
