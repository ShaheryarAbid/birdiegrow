---
/**
 * /contact/ — Figma "Contact" 341:29799 (mobile 577:82206). Copy is the existing page's, plus the design's card copy.
 * Content lives in src/data/contact.ts.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import LinkCards from "../components/sections/LinkCards.astro";
import Button from "../components/Button.astro";
import "../styles/sections.css";
import "../styles/pages.css";
import { CONTACT as page } from "../data/contact";
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  headerVariant="light"
>
  <div class="hm">
    <section class="pg-ct">
      <div class="pg-ct__top">
        <h1>{page.hero.h1}<i>.</i></h1>
        <p class="pg-ct__lead">{page.hero.lead}</p>
      </div>
      <div class="pg-ct__cards">
        <article class="pg-card pg-card--dark">
          <div>
            <h2>{page.demo.heading}</h2><p>{page.demo.text}</p>
          </div>
          <div class="hm-btns">
            <Button href={page.demo.cta.href} mode="light">{page.demo.cta.label}</Button>
          </div>
        </article>
        <article class="pg-card">
          <div>
            <h2>{page.email.heading}</h2><p>{page.email.text}</p>
          </div>
          <div class="pg-link">
            <a class="pg-link" href={`mailto:${page.email.address}`}>{page.email.address}</a>
            <button
              type="button"
              class="pg-copy"
              data-copy={page.email.address}
              aria-label="Copy email address"
            >
              <img
                src="/assets/pages/copy.svg"
                alt=""
                width="14"
                height="16"
              />
            </button>
          </div>
        </article>
        <article class="pg-card">
          <div>
            <h2>{page.login.heading}</h2><p>{page.login.text}</p>
          </div>
          <a class="pg-link" href={page.login.link.href} rel="noopener nofollow"
            >{page.login.link.label} <img
              src="/assets/ui/arrow-right.svg"
              alt=""
              width="16"
              height="16"
            /></a
          >
        </article>
      </div>
    </section>

    <LinkCards {...page.resources} />
  </div>
</BaseLayout>
<script is:inline>
  document.querySelectorAll("[data-copy]").forEach(function (b) {
    b.addEventListener("click", function () {
      var done = function () {
        b.classList.add("is-done");
        b.setAttribute("aria-label", "Email address copied");
        setTimeout(function () {
          b.classList.remove("is-done");
          b.setAttribute("aria-label", "Copy email address");
        }, 1800);
      };
      var failed = function () {
        b.setAttribute("aria-label", "Copy unavailable. Use the email link.");
      };
      try {
        navigator.clipboard
          .writeText(b.getAttribute("data-copy"))
          .then(done, failed);
      } catch (e) {
        failed();
      }
    });
  });
</script>
