<script is:inline>
  const $ = (id) => document.getElementById(id);
  const fmt = (n) => '$' + Math.round(n).toLocaleString();
  function calc() {
    const bays = +$('bays').value || 0, rate = +$('rate').value || 0, hrs = +$('hours').value || 0, util = (+$('util').value || 0) / 100;
    const gap = bays * hrs * 22 * rate * (1 - util); // weekday revenue left on the table, per month
    $('out').textContent = fmt(gap);
    $('outWk').textContent = fmt(gap / 4.33);
    $('outYr').textContent = fmt(gap * 12);
  }
  ['bays', 'rate', 'hours', 'util'].forEach((id) => $(id).addEventListener('input', calc));
  // +/- steppers (same wiring as CalcShell): nudge the real number input, then fire "input" so calc() reruns.
  document.querySelectorAll('[data-cc-step]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const input = document.getElementById(btn.dataset.target);
      if (!input) return;
      if (btn.dataset.ccStep === '+') input.stepUp(); else input.stepDown();
      input.dispatchEvent(new Event('input', { bubbles: true }));
    });
  });
  calc();
</script>
