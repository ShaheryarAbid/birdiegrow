---
/**
 * Content lives in src/data/golf-simulator-software.ts.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { GOLF_SIMULATOR_SOFTWARE as page } from "../data/golf-simulator-software";
import SeoHero from "../components/sections/SeoHero.astro";
import Glance from "../components/sections/Glance.astro";
import IconCards from "../components/sections/IconCards.astro";
import ComparisonTable from "../components/sections/ComparisonTable.astro";
import StatBand from "../components/sections/StatBand.astro";
import LinkCards from "../components/sections/LinkCards.astro";
import ArticleAccordion from "../components/sections/ArticleAccordion.astro";
import Faq from "../components/sections/Faq.astro";
import Cta from "../components/sections/Cta.astro";

const { quickAnswer, ...hero } = page.hero;
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  schema={page.schema}
  headerVariant="dark"
  headerOverlay
>
  <SeoHero {...hero}>{quickAnswer}</SeoHero>
  <Glance facts={page.facts} />
  <IconCards {...page.platform} h2Classes="max-w-540" />
  <ComparisonTable {...page.comparison} />
  <StatBand
    heading={page.stats.heading}
    title={page.stats.title}
    text={page.stats.text}
    stats={page.stats.items}
  />
  <LinkCards {...page.explore} />
  <ArticleAccordion {...page.article} />
  <Faq {...page.faq} open={1} balls />
  <Cta {...page.cta} />

  <style is:global>
    .hm-intro .hm-h2.max-w-540 { max-width: 540px; }
    @media (max-width: 900px) {
    }
  </style>
</BaseLayout>
