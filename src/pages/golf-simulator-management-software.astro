---
/**
 * Content lives in src/data/golf-simulator-management-software.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { GOLF_SIMULATOR_MANAGEMENT_SOFTWARE as page } from '../data/golf-simulator-management-software';
import SeoHero from '../components/sections/SeoHero.astro';
import Glance from '../components/sections/Glance.astro';
import CheckCards from '../components/sections/CheckCards.astro';
import PairCards from '../components/sections/PairCards.astro';
import TextBlock from '../components/sections/TextBlock.astro';
import ArticleAccordion from '../components/sections/ArticleAccordion.astro';
import Faq from '../components/sections/Faq.astro';
import LinkCards from '../components/sections/LinkCards.astro';
import Cta from '../components/sections/Cta.astro';

const { quickAnswer, ...hero } = page.hero;
---
<BaseLayout title={page.meta.title} description={page.meta.description} schema={page.schema} headerVariant="dark" headerOverlay>
  <SeoHero {...hero}>{quickAnswer}</SeoHero>
  <Glance facts={page.facts} />
  <CheckCards {...page.capabilities} />
  <PairCards {...page.problems} />
  <TextBlock {...page.remote} />
  <TextBlock tint {...page.phased} />
  <ArticleAccordion {...page.article} />
  <Faq {...page.faq} open={0} />
  <LinkCards {...page.related} />
  <Cta {...page.cta} />
</BaseLayout>
