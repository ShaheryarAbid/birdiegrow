---
/**
 * /platform/ — Figma "Platform" 366:15781 (mobile 577:83312). Copy and sample data are the existing page's.
 * Content lives in src/data/platform.ts.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Button from "../components/Button.astro";
import Cta from "../components/sections/Cta.astro";
import "../styles/sections.css";
import "../styles/pages.css";
import { PLATFORM as page } from "../data/platform";
import { gd } from "../lib/gd";

const { hero, portfolio, growth, booking } = page;
const B = "/assets/home/";
---

<BaseLayout
  title={page.meta.title}
  description={page.meta.description}
  headerVariant="light"
>
  <div class="hm">
    <section class="pg-pl-hero">
      <div>
        <h1 set:html={gd(hero.h1)} />
        <p>{hero.lead}</p>
      </div>
      <Button href={hero.cta.href} mode="dark">{hero.cta.label}</Button>
    </section>

    <section class="hm-sec hm-white">
      <div class="pg-pf">
        <div class="pg-pf__h">
          <h2 class="hm-h2" set:html={gd(portfolio.heading)} />
          <p class="hm-sub">{portfolio.sub}</p>
        </div>
        <div class="pg-pf__card">
          <div class="pg-pf__cap">
            <h3>{portfolio.title}</h3>
            <p>{portfolio.text}</p>
          </div>
          {
            /* Desktop and tablet: table. Mobile (below 600px): one card per venue, Figma 2049:91879. pages.css switches between them. */
          }
          <div class="pg-pf__tbl">
            <table>
              <caption class="sr-only" style="position:absolute;left:-9999px"
                >{portfolio.caption}</caption
              >
              <thead
                ><tr>{portfolio.columns.map((label) => <th>{label}</th>)}</tr></thead
              >
              <tbody
                >{
                  portfolio.venues.map(([v, b, o, r]) => (
                    <tr>
                      <>
                        <td>{v}</td>
                        <td>{b}</td>
                        <td>{o}</td>
                        <td>{r}</td>
                      </>
                    </tr>
                  ))
                }</tbody
              >
            </table>
          </div>
          <div class="pg-pf__venues">
            {
              portfolio.venues.map((venue) => (
                <dl class="pg-pf__venue">
                  {portfolio.columns.map((label, i) => (
                    <div>
                      <dt>{label}</dt>
                      {/* The non-breaking space keeps "— Scottsdale" together when the name wraps. */}
                      <dd>{venue[i].replace(" — ", " — ")}</dd>
                    </div>
                  ))}
                </dl>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <section class="hm-sec hm-white hm-stack">
      <div class="hm-intro">
        <h2 class="hm-h2" set:html={gd(growth.heading)} />
        <p class="hm-sub" style="max-width:600px; margin-bottom: 16px;">
          {growth.sub.before}
          <a
            href={growth.sub.link.href}
            style="color:var(--color-text);text-decoration:underline"
            >{growth.sub.link.label}</a
          >
          {growth.sub.after}
        </p>
        <Button href={growth.cta.href} mode="dark">{growth.cta.label}</Button>
      </div>
      <div class="pg-prog">
        <ol aria-label={growth.stepsLabel}>
          {growth.steps.map((step) => <li>{step}</li>)}
        </ol>
        <div class="pg-prog__vis" aria-hidden="true">
          <div class="pg-book">
            <div class="pg-book__sec">
              <div class="pg-book__head">
                <h3>{booking.dateLabel}</h3>
                <img src={`${B}icon-calendar.svg`} alt="" />
              </div>
              <div class="pg-book__row">
                {
                  booking.days.map(({ day, date, dots, state }) => (
                    <div class:list={["pg-book__day", state]}>
                      {state === "on" && (
                        <img class="pg-book__tex" src={`${B}tex-day.svg`} alt="" />
                      )}
                      <span>
                        {day}
                        <b>{date}</b>
                      </span>
                      <span class="pg-book__dots">
                        {dots.map((src) => (
                          <img src={src} alt="" />
                        ))}
                      </span>
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="pg-book__sec">
              <h3>{booking.timeLabel}</h3>
              <div class="pg-book__row">
                {
                  booking.times.map(({ label, state, mobileOnly }) => (
                    <div class:list={["pg-book__time", state, mobileOnly && "pg-book__time--extra"]}>
                      {state === "on" && (
                        <img class="pg-book__tex" src={`${B}tex-time.svg`} alt="" />
                      )}
                      {label}
                    </div>
                  ))
                }
              </div>
            </div>
            <hr class="pg-book__rule" />
            <div class="pg-book__sec">
              <h3>{booking.bayLabel}</h3>
              <div class="pg-book__bays">
                {
                  booking.bays.map(({ name, price, img, state, crop }) => (
                    <div class:list={["pg-book__bay", state]}>
                      <span class="pg-book__photo">
                        <img src={img} alt="" loading="lazy" style={crop} />
                      </span>
                      <b>{name}</b>
                      <small>{price}</small>
                      {state === "on" && (
                        <img class="pg-book__check" src={`${B}check-sm.svg`} alt="" />
                      )}
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <Cta {...page.cta} />
  </div>
</BaseLayout>
