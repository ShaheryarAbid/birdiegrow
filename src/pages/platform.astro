---
/** /platform/ — Figma "Platform" 366:15781 (mobile 577:83312). Copy and sample data are the existing page's. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import Cta from '../components/sections/Cta.astro';
import '../styles/sections.css';
import '../styles/pages.css';
import { SITE } from '../consts';

const title = 'Multi-Location Platform for Golf Simulator Venues | Birdie';
const description = 'Start with one venue and scale to many. Manage every location with one Birdie login and a location switcher.';

const venues = [
  ['Downtown', '124', '68%', '$9,320'],
  ['West End', '98', '55%', '$7,140'],
  ['Royal Fairway — Scottsdale', '156', '74%', '$11,880'],
  ['Royal Fairway — Denver', '89', '48%', '$6,450'],
];
const progression = ['Booking System', 'Website', 'Local SEO', 'Automated Campaigns', 'Full Revenue Platform'];
const B = '/assets/home/';
---
<BaseLayout title={title} description={description} headerVariant="light">
  <div class="hm">
    <section class="pg-pl-hero">
      <div>
        <h1>One Platform<i>.</i> One Login<i>.</i> Every Location<i>.</i></h1>
        <p>Start with one venue. Scale to many. Birdie grows with you.</p>
      </div>
      <Button href={SITE.demoPath} mode="dark">Book a Demo</Button>
    </section>

    <section class="hm-sec hm-white">
      <div class="pg-pf">
        <div class="pg-pf__h">
          <h2 class="hm-h2">One login across all your locations<i>.</i></h2>
          <p class="hm-sub">Switch between your venues with a location switcher, from the same login.</p>
        </div>
        <div class="pg-pf__card">
          <div class="pg-pf__cap">
            <h3>Portfolio overview</h3>
            <p>Example venues and figures, shown to illustrate the multi-location dashboard. Not real customer data or industry benchmarks.</p>
          </div>
          <div class="pg-pf__tbl">
            <table>
              <caption class="sr-only" style="position:absolute;left:-9999px">Portfolio overview — sample data</caption>
              <thead><tr><th>Venue</th><th>Bookings</th><th>Occupancy</th><th>Revenue</th></tr></thead>
              <tbody>{venues.map(([v, b, o, r]) => (<tr><td>{v}</td><td>{b}</td><td>{o}</td><td>{r}</td></tr>))}</tbody>
            </table>
          </div>
        </div>
      </div>
    </section>

    <section class="hm-sec hm-white hm-stack" style="padding-top:0">
      <div class="hm-intro">
        <h2 class="hm-h2">Start with bookings<i>.</i> Expand when you're ready<i>.</i></h2>
        <p class="hm-sub" style="max-width:600px">Birdie begins as your booking engine — then becomes the <a href="/golf-simulator-management-software/" style="color:var(--color-text);text-decoration:underline">golf simulator management software</a> running your entire business. No bloated stack required.</p>
        <Button href="/golf-simulator-management-software/" mode="dark">Golf simulator management software</Button>
      </div>
      <div class="pg-prog">
        <div class="pg-prog__bg"><img src="/assets/features/door-panel-bg.webp" alt="" loading="lazy" /><div class="fade"></div></div>
        <ol aria-label="How Birdie grows with you">{progression.map((step) => <li>{step}</li>)}</ol>
        <div class="pg-prog__vis" aria-hidden="true">
          <div class="pg-book">
            <div><h3>Date: September 2026</h3><div class="pg-book__days"><span class="on">WED<br />9</span><span>THU<br />10</span><span>FRI<br />11</span><span>SAT<br />12</span><span>SUN<br />13</span></div></div>
            <div><h3>Time</h3><div class="pg-book__times"><span>6:00 AM</span><span class="on">7:00 AM</span><span>8:00 AM</span></div></div>
            <div><h3>Bay</h3>
              <div class="pg-book__bays">
                <div class="on"><img src={`${B}bay-callaway.webp`} alt="" /><span>Callaway</span><small>$45/hour</small></div>
                <div><img src={`${B}bay-titleist.webp`} alt="" /><span>Titleist</span><small>$45/hour</small></div>
                <div><img src={`${B}bay-taylormade.webp`} alt="" /><span>TaylorMade</span><small>$45/hour</small></div>
              </div>
            </div>
            <p class="pg-book__note">Illustrative booking flow.</p>
          </div>
        </div>
      </div>
    </section>

    <Cta heading="Ready to see the full platform?" body="Free walkthrough. No commitment. We handle all setup." items={[]} label="Book a Demo" />
  </div>
</BaseLayout>
