---
/**
 * Content lives in src/data/golf-simulator-booking-software.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { GOLF_SIMULATOR_BOOKING_SOFTWARE as page } from '../data/golf-simulator-booking-software';
import SeoHero from '../components/sections/SeoHero.astro';
import Glance from '../components/sections/Glance.astro';
import FeatureGrid from '../components/sections/FeatureGrid.astro';
import CheckCards from '../components/sections/CheckCards.astro';
import ComparisonTable from '../components/sections/ComparisonTable.astro';
import StatBand from '../components/sections/StatBand.astro';
import TextBlock from '../components/sections/TextBlock.astro';
import Faq from '../components/sections/Faq.astro';
import LinkCards from '../components/sections/LinkCards.astro';
import Cta from '../components/sections/Cta.astro';

const { quickAnswer, ...hero } = page.hero;
---
<BaseLayout title={page.meta.title} description={page.meta.description} schema={page.schema} headerVariant="dark" headerOverlay>
  <SeoHero {...hero}>{quickAnswer}</SeoHero>
  <Glance facts={page.facts} />
  <FeatureGrid {...page.fails} />
  <CheckCards heading={page.should.heading} groups={[['', page.should.items]]} />
  <FeatureGrid {...page.choose} />
  <FeatureGrid {...page.reservation} cols={2} />
  <ComparisonTable {...page.comparison} />
  <StatBand heading={page.stats.heading} text={page.stats.text} stats={page.stats.items} />
  <TextBlock {...page.door} />
  <Faq {...page.faq} open={0} />
  <LinkCards {...page.related} />
  <Cta {...page.cta} />

  <style is:global>
    @media (max-width: 900px) {
      .hm-sub {
        margin-bottom: 8px !important;
      }
    }
  </style>
</BaseLayout>
