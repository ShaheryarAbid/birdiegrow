# Cloudflare Pages redirects. Format: /from  /to  [status]
#
# Path-level 301s: map any OLD Lovable URLs that change to their new slugs here,
# so you keep ranking equity during the migration. Example:
# /old-pricing-page   /#pricing   301
#
# Host canonicalization (www <-> apex) and http->https are best set as a
# Cloudflare "Redirect Rule" in the dashboard, not here — see the README.
#
# NOTE: the current live site canonicalizes to www.birdiegrow.com. Decide the
# canonical host BEFORE cutover and 301 the other host to it consistently.

# Serve the Astro-generated sitemap index at the conventional /sitemap.xml path
/sitemap.xml   /sitemap-index.xml   200

# NOTE: the build uses `format: 'directory'`, so every real route ends in a
# trailing slash. Redirect TARGETS must include it, or each redirect becomes a
# 301 -> 301 chain (fixed 2026-09-09).

# Removed thin per-state location pages — 301 the old slugs to the software pillar
/golf-simulator-software-*   /golf-simulator-software/   301

